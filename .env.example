# Wajib di produksi (DEBUG=False menolak start tanpa SECRET_KEY sendiri)
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Login Google (client ID yang sama dengan Google Identity Services di frontend)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Frontend: asal CORS (pisahkan dengan koma) dan URL untuk tautan di email
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# POST /api/v1/auth/dev-login tanpa Google (diabaikan bila DEBUG=False, kecuali opsi di bawah)
AUTH_DEV_LOGIN=False
# Izinkan dev-login walau DEBUG=False (khusus prototipe; siapa pun bisa login sebagai akun apa pun)
# AUTH_DEV_LOGIN_ALLOW_PRODUCTION=False

# Database: kosongkan untuk SQLite; isi untuk PostgreSQL (pip install "psycopg[binary]")
# DB_ENGINE=postgres
# DB_NAME=ritelhub
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Email notifikasi (default: dicetak ke console)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=RitelHub <no-reply@example.com>
NOTIFICATION_EMAILS=True

# URL publik API untuk membangun URL file absolut (opsional)
# PUBLIC_BASE_URL=https://api.example.com

# Opsional: masa berlaku token & batas laju
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=14
# THROTTLE_AUTH=20/min

# Produksi di balik proxy HTTPS
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
